# .archiveignore — Exclusion patterns for ConvertTo-FolderArchive.ps1
# Same syntax as .gitignore:
#   - One pattern per line
#   - Lines starting with # are comments
#   - *  matches any character except /
#   - ** matches any path
#   - A name without / matches anywhere in the tree
#
# Rename this file to .archiveignore and place it at the root of the folder to encode.
# On Windows: Rename-Item .archiveignore.template .archiveignore

# -----------------------------------------------
# Version control
# -----------------------------------------------
.git
.gitignore
.gitattributes
.gitmodules
.svn
.hg

